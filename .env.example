# ── Runtime ──────────────────────────────────────────────────────────────────
# "production" enforces the guardrails below: a DB password, a bot token and a
# webhook secret must all be set or the application refuses to start.
APP_ENV=development

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram sends it back in a header on every call, and
# without it anyone who learns the URL can post updates as if they were Telegram.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://recepcao.seudominio.com.br

# ── WhatsApp Cloud API, direto com a Meta (docs/WHATSAPP.md) ────────────────
# Liga com quatro: APP_SECRET (confere a assinatura de cada chamada da Meta),
# PHONE_NUMBER_ID e ACCESS_TOKEN (enviam) e WEBHOOK_VERIFY_TOKEN (uma string
# longa que você inventa e cadastra no webhook da Meta). Faltando qualquer um,
# o webhook responde 503 e o Telegram segue igual. O webhook usa o
# PUBLIC_BASE_URL acima: <PUBLIC_BASE_URL>/whatsapp/webhook.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# O modelo aprovado do lembrete. Vazio: lembrete de contato do WhatsApp não sai.
WHATSAPP_REMINDER_TEMPLATE=lembrete_conversa
# Template aprovado que retoma uma conversa que ficou pela metade (automação
# "Parou no meio"). Vazio: as automações pulam quem é do WhatsApp.
WHATSAPP_RESUME_TEMPLATE=
WHATSAPP_RESUME_LANGUAGE=pt_BR
# Modelos de cobrança, pagamento recebido e resposta da equipe (docs/WHATSAPP.md).
# Só valem depois de 24h sem o cliente escrever. Vazio: segue recusando/pulando.
WHATSAPP_CHARGE_TEMPLATE=
WHATSAPP_PAID_TEMPLATE=
WHATSAPP_TEAM_TEMPLATE=
# Idioma em que cada um foi aprovado, como no WhatsApp Manager ("en" se English).
WHATSAPP_PAID_LANGUAGE=pt_BR
WHATSAPP_TEAM_LANGUAGE=pt_BR
# Primeira mensagem ao lead cadastrado no painel: a de e-mail para quem veio
# por e-mail, a geral para as outras origens (docs/WHATSAPP.md).
WHATSAPP_LEAD_TEMPLATE=
WHATSAPP_LEAD_GENERAL_TEMPLATE=
# Proposta em PDF depois de 24h sem o cliente escrever (docs/WHATSAPP.md, modelo 7).
WHATSAPP_PROPOSAL_TEMPLATE=
# Pedido de mais informações para a proposta depois de 24h (docs/WHATSAPP.md, modelo 8).
WHATSAPP_INFO_TEMPLATE=
WHATSAPP_GRAPH_VERSION=v23.0

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_SIMPLE_PROVIDER=openai
LLM_COMPLEX_PROVIDER=openai
LLM_SIMPLE_MODEL=gpt-4o-mini
LLM_COMPLEX_MODEL=gpt-4o
# Per-role overrides. Empty inherits the two models above.
ROUTER_MODEL=
RECEPTION_MODEL=
DRAFTING_MODEL=

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reception_agent
DB_USER=reception_agent
DB_PASSWORD=
DB_SSLMODE=prefer            # "require" against a managed PostgreSQL

# ── Redis (durable update queue + cache) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# ── Workspace suite ──────────────────────────────────────────────────────────
# google | microsoft. The four overrides below are for a split tenant; leave
# them empty to follow WORKSPACE_PROVIDER.
WORKSPACE_PROVIDER=google
CALENDAR_PROVIDER=
MAIL_PROVIDER=
FILES_PROVIDER=
SHEETS_PROVIDER=

# ── Google Workspace ─────────────────────────────────────────────────────────
# service_account: a Workspace admin grants domain-wide delegation once, and
#   GOOGLE_DELEGATED_SUBJECT is the account the agent acts as.
# refresh_token:   no admin needed. Run `python cli/authorize_google.py` with one
#   shared account and paste the token it prints.
GOOGLE_AUTH_MODE=service_account
GOOGLE_CREDENTIALS_PATH=google_credentials.json
GOOGLE_DELEGATED_SUBJECT=team@getconverge.me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Trim this to what the deployment actually uses — an unused scope is standing
# access to data nobody is reading.
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/gmail.modify

# ── Microsoft 365 ────────────────────────────────────────────────────────────
# An Entra ID app registration with application permissions (Calendars.ReadWrite,
# Mail.ReadWrite, Mail.Send, Files.ReadWrite.All), admin-consented.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DEFAULT_UPN=team@getconverge.me
MS_DRIVE_ID=                 # a SharePoint library id, instead of a OneDrive

# ── Front desk ───────────────────────────────────────────────────────────────
ORGANIZATION_NAME=Converge
OFFICE_TIMEZONE=America/Belem
OFFICE_START_HOUR=9
OFFICE_END_HOUR=18
OFFICE_WORKDAYS=1,2,3,4,5    # ISO weekdays: 1 = Monday, 7 = Sunday
# true: the bot answers every message immediately, any hour, any day. A
# booking still only offers real office hours above — this never touches that.
# false (default): the bot itself keeps the same hours as the office.
DESK_ALWAYS_OPEN=false
# The organization's own words live in content/. Point this elsewhere to run a
# second client from the same image.
CONTENT_DIR=content
# Leave empty to use content/messages.toml. Set it only to override that file.
OUT_OF_HOURS_REPLY=
# Telegram chat ids that never see the desk as closed, comma-separated — for
# staff testing outside real hours. Leave empty in production; it bypasses
# nothing else (booked times still come from the real office hours).
HOURS_BYPASS_CHAT_IDS=
# The /painel dashboard: per-person accounts with password + authenticator app.
# Encrypts the MFA secrets at rest; empty keeps the panel closed. Keep a copy
# outside the server — losing it means everyone enrolls again. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# People are invited with: python -m cli.panel_users invite <email> --telegram
PANEL_SECRET_KEY=
PANEL_SESSION_HOURS=12
PANEL_IDLE_MINUTES=120
# Opt-in trusted devices: expires after this many days without use.
PANEL_DEVICE_IDLE_DAYS=90
# The team's Telegram group: handoff cards land there, and replying to a card
# answers the person through the bot. Add the bot to the group and send /id.
TEAM_CHAT_ID=
# System alerts on Telegram go to this chat, with the admins only. Empty: error
# alerts stay in the app (push) and the admin room, and "bot down" goes to the
# team group above. Send /id in the chat to learn its id.
ADMIN_ALERT_CHAT_ID=
# Errors of one kind: at most one alert per this many minutes, with the count.
ERROR_ALERT_MINUTES=15
# Grafana (deploy/docker-compose.observability.yml): a long random value. The
# password login is off (the panel lets people in); it only guards the
# internal admin account.
GRAFANA_ADMIN_PASSWORD=
# /teste: someone in staff.json is served as a customer, marked TESTE; the test
# ends and is wiped on /sair or after this many minutes without a message.
TEST_IDLE_MINUTES=120

# ── Phase 1.1: the knowledge the desk answers from ───────────────────────────
# A file under CONTENT_DIR for a pilot; a document id in the client's own drive
# in production, which wins when both are set.
KNOWLEDGE_DOCUMENT_PATH=faq.md
KNOWLEDGE_DOCUMENT_ID=
KNOWLEDGE_TOP_K=6
# A coarse floor, not the real filter — the model refuses when the retrieved
# text does not answer. Calibrate against real questions before a pilot.
KNOWLEDGE_MIN_SIMILARITY=0.25

# ── Phase 2: scheduling ──────────────────────────────────────────────────────
# The calendar appointments are written into.
RECEPTION_CALENDAR_ID=team@getconverge.me
# Whose diaries decide availability. Comma-separated; a slot is only offered
# when it is free on all of them. Empty falls back to the calendar above.
STAFF_CALENDAR_IDS=
APPOINTMENT_DURATION_MINUTES=30
SLOT_STEP_MINUTES=30
BOOKING_HORIZON_DAYS=30
MINIMUM_NOTICE_MINUTES=120   # never offer something starting sooner than this
SLOTS_OFFERED=3
# suggest: 3 spread-out times (default). choose_day: the days with free times,
# then the chosen day's times.
BOOKING_MODE=suggest
# Upcoming confirmed appointments one contact may hold; 0 = no limit (max 5).
MAX_UPCOMING_APPOINTMENTS=0
SLOT_MIN_GAP_MINUTES=120    # least time between two offered slots
# Each booking as a video meeting (Google Meet); the link goes to the person.
ONLINE_MEETINGS=false
REMINDER_HOURS_BEFORE=24
# Booked less than REMINDER_HOURS_BEFORE ahead: reminded this many minutes before.
LATE_REMINDER_MINUTES=60
OFFER_TTL_MINUTES=60         # how long an offered time is still "a terca"

# ── Phase 3: mailbox and documents ───────────────────────────────────────────
RECEPTION_MAILBOX=team@getconverge.me
INBOX_POLL_MINUTES=10
INBOX_BATCH_SIZE=25
# Leave false. A drafted reply waits for a person; turning this on is a
# deliberate decision and the drafts table records that it was made.
AUTOSEND_REPLIES=false
ESCALATION_MAILBOX=team@getconverge.me

# ── Spacemail: the mailbox the agent sends from (reminders, documents) ──────
# Send only, over SMTP. Both USERNAME and PASSWORD must be set, or it stays off
# and the Google/Microsoft mailbox sends as before. The password goes only in
# the server's .env.
SPACEMAIL_HOST=mail.spacemail.com
SPACEMAIL_PORT=465
SPACEMAIL_USERNAME=
SPACEMAIL_PASSWORD=
# Tell the team (Telegram group + push) when a person's e-mail arrives in that
# mailbox. Read only: nothing is marked as read. Leave false until wanted.
SPACEMAIL_ALERTS=false
EMAIL_ALERT_MINUTES=5
# A cobrança e o pagamento recebido também por e-mail ao cliente (precisa do e-mail no contato).
BILLING_EMAILS=false

DOCUMENTS_ROOT_FOLDER_ID=
# The ONLY folder a file may be e-mailed out of without a person approving it.
# Empty means nothing is auto-shareable, which is the safe default.
SHAREABLE_FOLDER_ID=

# ── Phase 4: secretarial ─────────────────────────────────────────────────────
MINUTES_FOLDER_ID=
# The morning briefing in the team group (TEAM_CHAT_ID), on OFFICE_WORKDAYS.
# /resumo in the group posts it on demand.
DAILY_BRIEFING_HOUR=8
FOLLOWUP_AFTER_DAYS=3

# ── Observability ────────────────────────────────────────────────────────────
METRICS_ENABLED=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Traces carry the words people wrote to the desk. Leave this false.
LANGSMITH_CAPTURE_CONTENT=false

# ── Photos, files and audio in the Inbox ──────────────────────────────────────
# Capture only (needs TEAM_CHAT_ID). Showing and cleaning up what was kept run
# always. Ranges are fixed by the privacy policy; see docs/CRIPTOGRAFIA.md.
MEDIA_ENABLED=false
# Staff may upload photos, files and voice notes in Inbox and Administration.
PANEL_UPLOADS_ENABLED=false
# Manual local OCR in the Inbox (images/PDFs); no provider or API key.
INBOX_OCR_ENABLED=false
# Push notifications in the panel app. Generate on the server with
# deploy/push-keys.sh (never by hand); without all three, notifications are off.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
# ── Asaas, cobrança da Converge (docs/ASAAS.md) ─────────────────────────────
# Sem a chave, pagamentos desligados. A chave começa com `$`: SEMPRE entre
# aspas simples, senão o Docker Compose lê `$aact_…` como variável e corta.
# ASAAS_API_KEY='$aact_hmlg_...'
ASAAS_API_KEY=
ASAAS_ENV=sandbox                   # sandbox | production
# Conferido no cabeçalho asaas-access-token do webhook (gerar, nunca reusar a chave).
ASAAS_WEBHOOK_TOKEN=
# ── Autentique, assinatura do contrato ─────────────────────────────────────
# Sem a chave, o botão "Enviar para assinatura" não aparece. Em sandbox o
# documento não custa nada e não vale juridicamente; contato em /teste vai
# sempre para o sandbox.
AUTENTIQUE_API_KEY=
AUTENTIQUE_SANDBOX=true
# Segredo do webhook (Painel do desenvolvedor da Autentique, eventos
# signature.accepted e document.finished, URL https://<host>/autentique/webhook).
# Sem ele, o endereço responde 404 e o card não fica sabendo do assinado.
AUTENTIQUE_WEBHOOK_SECRET=
# Quem assina pela Converge.
CONTRACT_SIGNER_NAME=
CONTRACT_SIGNER_EMAIL=
# MEDIA_DIR=/data/media
# MAX_MEDIA_BYTES=20971520          # per file, 1 MB to 20 MB
# MEDIA_MAX_TOTAL_MB=3072           # everything kept
# MEDIA_MIN_FREE_MB=2048            # free space left on the volume for the databases
# MEDIA_DOWNLOAD_SECONDS=60         # 5 to 120
# MEDIA_AUDIO_HOURS=48              # 1 to 48
# MEDIA_AUDIO_MAX_HOURS=168         # with a request open in the Inbox; up to 168
# MEDIA_RETENTION_DAYS=90           # photos, videos, files; 1 to 90
# MEDIA_CLEANUP_MINUTES=15          # 1 to 15
# MEDIA_SERVE_CONCURRENCY=4         # files open in memory at once, 1 to 8

# The panel's agenda: how often the team's calendars are mirrored, 1 to 15.
# CALENDAR_SYNC_MINUTES=5
