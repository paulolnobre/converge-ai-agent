#!/usr/bin/env bash
# Blocks a commit that would put a secret or a person's id into the repository.
# Enabled once per clone:  git config core.hooksPath .githooks
#
# Fails closed: without gitleaks the commit is refused, not waved through —
# a check that silently does nothing is how the first leak gets in.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so this commit cannot be checked for secrets."
  echo "  Install: https://github.com/gitleaks/gitleaks#installing (a single binary)"
  echo "  Emergency only, and never for .env or credentials: git commit --no-verify"
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml; then
  echo
  echo "pre-commit: the commit was blocked — the finding above would enter the history."
  echo "  Real secret or id: remove it from the file (move it to .env or a git-ignored file)."
  echo "  Placeholder or test value: make it obviously fake, or add it to .gitleaks.toml's allowlist."
  exit 1
fi
